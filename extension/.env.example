# Basisadresse des Mitgliedschafts-Backends (dieses Repo). Lokal der Dev-Server,
# in Produktion die oeffentliche Adresse. Wird beim Bauen in den Code geschrieben;
# im Quelltext steht sie nirgends.
ADSILENCE_API=http://localhost:3000

# Oeffentlicher Schluessel fuer das Chromium-Manifest ("key"), damit die
# Erweiterungs-ID beim Laden aus dist/chromium fest bleibt. Leer lassen, wenn
# egal; der Store vergibt beim Hochladen ohnehin eine eigene.
ADSILENCE_MANIFEST_KEY=

# Deine Apple-Team-ID (10 Zeichen, steht im Apple Developer Portal unter
# Membership). Ist sie gesetzt, traegt `npm run safari` sie ins Xcode-Projekt
# ein, und das Projekt laesst sich ohne weiteren Handgriff archivieren.
# Leer lassen ist in Ordnung; dann fragt Xcode beim ersten Bauen danach.
ADSILENCE_TEAM_ID=
